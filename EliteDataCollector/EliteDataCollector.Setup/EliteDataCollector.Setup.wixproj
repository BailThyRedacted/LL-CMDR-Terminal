<Project Sdk="Microsoft.NET.Sdk/latest">
  <PropertyGroup>
    <OutputType>exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>

    <!-- WiX Toolset properties (if using WiX as library) -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <AssemblyName>EliteDataCollector.Setup</AssemblyName>
  </PropertyGroup>

  <Target Name="BuildMSI" BeforeTargets="Build">
    <Exec Command="wix build -o bin\Debug\EliteDataCollector-Setup.msi Product.wxs -ext WixToolset.UI.wixext" WorkingDirectory="$(ProjectDir)" />
  </Target>
</Project>
